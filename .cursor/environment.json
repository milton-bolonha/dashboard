{
  "version": "1.0",
  "name": "generic-environment",
  "description": "Auto-generated environment for generic project",
  "base": {
    "image": "ubuntu:22.04",
    "packages": [
      "curl",
      "git",
      "build-essential",
      "python3",
      "python3-pip"
    ]
  },
  "node": {
    "version": ">=18.0.0",
    "package_manager": "npm"
  },
  "install": "npm ci --prefer-offline --no-audit",
  "start": "echo 'Starting generic Node.js environment...'",
  "terminals": [
    {
      "name": "Development",
      "command": "npm run dev || npm start"
    }
  ],
  "environment": {
    "NODE_ENV": "development"
  },
  "ports": [
    3000
  ],
  "healthcheck": {
    "url": "http://localhost:3000",
    "timeout": 30000
  },
  "security": {
    "allowed_domains": [
      "github.com",
      "npmjs.com",
      "nodejs.org",
      "cdn.jsdelivr.net",
      "unpkg.com"
    ],
    "blocked_commands": [
      "rm -rf /*",
      "rm -rf ~/",
      "dd if=/dev/zero",
      ":(){ :|:& };:",
      "wget * | sh",
      "curl * | sh"
    ],
    "environment_variables": {
      "required": [],
      "optional": [
        "DATABASE_URL",
        "API_KEY",
        "JWT_SECRET"
      ]
    }
  }
}
