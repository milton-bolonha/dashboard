## Code Examples

### Error Handling
```javascript
async function fetchData(id) {
  try {
    const response = await api.get(`/data/${id}`);
    
    if (!response.ok) {
      throw new Error(`HTTP ${response.status}: ${response.statusText}`);
    }
    
    return response.data;
  } catch (error) {
    console.error('Failed to fetch data:', error);
    throw error; // Re-throw for caller to handle
  }
}
```

### Input Validation
```javascript
function processUser(userData) {
  if (!userData || typeof userData !== 'object') {
    throw new Error('Invalid user data: expected object');
  }
  
  const { name, email } = userData;
  
  if (!name || typeof name !== 'string') {
    throw new Error('Invalid name: expected non-empty string');
  }
  
  if (!email || !isValidEmail(email)) {
    throw new Error('Invalid email format');
  }
  
  // Process validated data
  return processValidatedUser({ name, email });
}
```

### Async Operations
```javascript
// Prefer this
async function updateUserProfile(userId, profileData) {
  const user = await User.findById(userId);
  const updatedUser = await user.update(profileData);
  return updatedUser;
}

// Over this
function updateUserProfile(userId, profileData, callback) {
  User.findById(userId, (err, user) => {
    if (err) return callback(err);
    user.update(profileData, callback);
  });
}
```

