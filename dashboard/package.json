{
  "name": "dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./lib/*",
    "#components/*": "./components/*",
    "#contexts/*": "./contexts/*",
    "#hooks/*": "./hooks/*",
    "#schemas/*": "./schemas/*"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --test tests/*.js",
    "test:sidebar": "node --test tests/sidebar-hover.test.js",
    "test:middleware": "node --test tests/middleware-clerk.test.js",
    "test:api": "node --test tests/api-corrections.test.js",
    "test:cloudinary": "node --test tests/cloudinary.test.js",
    "test:corrections": "npm run test:sidebar && npm run test:middleware && npm run test:api",
    "test:all": "npm run test:corrections && npm run test:cloudinary",
    "setup": "node scripts/setup-env.js",
    "setup:superadmin": "node scripts/generate-superadmin-key.js",
    "migrate:workspaces": "node scripts/run-migration.js",
    "sync:clerk": "node scripts/sync-clerk-users.js"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.23.0",
    "@fontsource-variable/geologica": "^5.2.6",
    "@fontsource-variable/podkova": "^5.2.8",
    "@fontsource/poppins": "^5.2.6",
    "@heroicons/react": "^2.2.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.7.0",
    "dotenv": "^17.0.0",
    "jose": "^6.0.11",
    "mongodb": "^6.3.0",
    "next": "15.3.4",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^12.14.0",
    "supertest": "^7.1.1",
    "uuid": "^11.1.0",
    "yaml": "^2.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "15.3.4",
    "puppeteer": "^22.13.1",
    "tailwindcss": "^4"
  }
}
